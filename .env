# ─────────────────────────────────────────────────────────────────
#  BASE DE DONNÉES
# ─────────────────────────────────────────────────────────────────

# Mot de passe PostgreSQL (utilisé par docker-compose pour créer le user)
DB_PASSWORD_SCRAPER=scraperHamza123
DB_PASSWORD_AUTH=authHamza123

# URL complète pour l'app principale (auth_db)
# ✅ Avec Docker Compose → utiliser "postgres" (nom du service)
DATABASE_URL=postgresql://postgres.erzutohrpvmrbccdnlig:authHamza123@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# URL complète pour les microservices (scraper_db)
# ✅ Avec Docker Compose → utiliser "postgres" (nom du service)
DATABASE_URL_SCRAPER=postgresql://postgres.lidngmhnvtijljgfkuvk:scraperHamza123@aws-1-eu-north-1.pooler.supabase.com:6543/postgres

# ⚠️ EN LOCAL (sans Docker) → remplacer "postgres" par "localhost"
# DATABASE_URL=postgresql://postgres:123456@localhost/auth_db
# DATABASE_URL_SCRAPER=postgresql://postgres:123456@localhost/scraper_db


# ─────────────────────────────────────────────────────────────────
#  JWT — App principale (port 8000)
# ─────────────────────────────────────────────────────────────────

# Clé secrète pour signer les tokens JWT
# Générer une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=comparisonplatformhamza123secretkey26404985

# Algorithme de signature (ne pas modifier)
ALGORITHM=HS256

# Durée de vie des tokens d'accès en minutes (défaut : 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ─────────────────────────────────────────────────────────────────
#  CORS — Origines autorisées
# ─────────────────────────────────────────────────────────────────

# URLs du frontend autorisées à appeler l'API
# En développement local :
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# En production, ajouter l'URL déployée :
# FRONTEND_URLS=http://localhost:5173,https://mon-frontend.vercel.app


# ─────────────────────────────────────────────────────────────────
#  EMAIL — Service 3 alertes (port 8003)
# ─────────────────────────────────────────────────────────────────

# Adresse Gmail qui envoie les alertes
GMAIL_USER=hamza.chikhe50@gmail.com

# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Créer ici : https://myaccount.google.com/apppasswords
# Format : 4 groupes de 4 lettres séparés par des espaces
GMAIL_APP_PASSWORD=bkro bhle rvxq vgvb


# ─────────────────────────────────────────────────────────────────
#  SCHEDULER — Vérification automatique des alertes
# ─────────────────────────────────────────────────────────────────

# Heure de vérification automatique chaque nuit (format 24h)
ALERT_CHECK_HOUR=3
ALERT_CHECK_MINUTE=30
