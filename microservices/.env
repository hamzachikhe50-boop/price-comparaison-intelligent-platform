# ── Base de données ───────────────────────────
# ⚠️  EN LOCAL (sans Docker) → utiliser localhost
DATABASE_URL=postgresql://postgres:123456@localhost/scraper_db

# ⚠️  AVEC Docker Compose → utiliser le nom du service postgres
# DATABASE_URL=postgresql://postgres:123456@postgres/scraper_db

# ── Email (Gmail) ─────────────────────────────
